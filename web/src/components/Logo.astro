---
interface Props {
  storrelse?: 'stor' | 'liten'
}
const {storrelse = 'stor'} = Astro.props
---

<a href="/" class={`logo logo--${storrelse}`} aria-label="Fotograf Karoline Rage – til forsiden">
  <span class="logo__navn">karolinerage</span>
  <span class="logo__under"><span></span>FOTOGRAF<span></span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--svart);
  }
  .logo__navn {
    font-family: var(--skrift);
    font-size: 64px;
    line-height: 1;
    letter-spacing: 2px;
  }
  .logo__under {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 11px;
    letter-spacing: 4px;
    margin-top: -2px;
  }
  .logo__under span {
    width: 90px;
    height: 1px;
    background: var(--svart);
  }
  .logo--liten .logo__navn {
    font-size: 30px;
    letter-spacing: 0;
  }
  .logo--liten .logo__under {
    font-size: 7px;
    letter-spacing: 2.5px;
    gap: 6px;
    margin-top: 0;
  }
  .logo--liten .logo__under span {
    width: 36px;
  }
</style>
