---
interface Props {
  storrelse?: 'stor' | 'liten'
}
const {storrelse = 'stor'} = Astro.props
---

<a href="/" class={`logo logo--${storrelse}`} aria-label="Fotograf Karoline Rage – til forsiden">
  <span class="logo__navn">karolinerage</span>
  <span class="logo__under"><span></span>FOTOGRAF<span></span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--svart);
  }
  .logo__navn {
    font-family: var(--skrift);
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: 0;
  }
  .logo__under {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-weight: 300;
    font-optical-sizing: auto;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--under);
    margin-top: -2px;
  }
  .logo__under span {
    width: 90px;
    height: 1px;
    background: var(--under);
  }
  .logo--liten .logo__navn {
    font-size: 30px;
  }
  .logo--liten .logo__under {
    gap: 8px;
    margin-top: 2px;
  }
  .logo--liten .logo__under span {
    width: 28px;
  }
</style>
