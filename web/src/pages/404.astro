---
import Base from '../layouts/Base.astro'
---

<Base tittel="Siden mangler innhold" noindex>
  <section class="smal">
    <p class="etikett">404</p>
    <h1 style="font-size: clamp(34px, 4.2vw, 56px); margin-top: 20px;">Denne siden mangler innhold</h1>
    <span class="strek strek--tett"></span>
    <p class="ingress" style="margin-top: 28px;">Mangler du en fotograf, kan du kontakte meg her. Du kan også gå tilbake til forsiden.</p>
    <p style="margin-top: 40px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/kontakt" class="knapp">Gå til kontakt</a>
      <a href="/" class="knapp">Til forsiden</a>
    </p>
  </section>
</Base>
