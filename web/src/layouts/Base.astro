---
import '@fontsource/fraunces/300.css'
import '@fontsource/fraunces/300-italic.css'
import '@fontsource/fraunces/400.css'
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/sacramento/400.css'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {innstillinger, kategorier} from '../lib/data'
import {bildeUrl, harBilde} from '../lib/bilde'
import {kortTekst} from '../lib/tekst'
import type {Bilde} from '../lib/typer'

interface Props {
  tittel?: string
  beskrivelse?: string
  delingsbilde?: Bilde
  aktiv?: 'hjem' | 'bryllup' | 'andre' | 'galleri' | 'om' | 'kontakt'
  /** Strukturerte data (JSON-LD) for Google og KI-tjenester */
  schema?: object | object[]
  type?: 'website' | 'article'
  noindex?: boolean
}

const i = await innstillinger()
const k = await kategorier()
const {tittel, beskrivelse, delingsbilde, aktiv, schema, type = 'website', noindex = false} = Astro.props

const fullTittel = tittel ? `${tittel} | Karoline Rage` : i?.seoTittel || 'Fotograf Karoline Rage'
const besk = beskrivelse || kortTekst(i?.seoBeskrivelse || i?.omTekst || '')
const bilde = harBilde(delingsbilde ?? null) ? delingsbilde : i?.delingsbilde
const ogBilde = harBilde(bilde ?? null) ? bildeUrl(bilde!, 1200, 1200 / 630) : undefined
const kanonisk = new URL(Astro.url.pathname, Astro.site).href
const schemaListe = schema ? (Array.isArray(schema) ? schema : [schema]) : []
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTittel}</title>
    {besk && <meta name="description" content={besk} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={kanonisk} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content={i?.navn || 'Fotograf Karoline Rage'} />
    <meta property="og:title" content={fullTittel} />
    {besk && <meta property="og:description" content={besk} />}
    <meta property="og:url" content={kanonisk} />
    {ogBilde && <meta property="og:image" content={ogBilde} />}
    <meta name="twitter:card" content="summary_large_image" />
    {schemaListe.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#innhold" class="skjult">Hopp til innholdet</a>
    <Header aktiv={aktiv} />
    <main id="innhold">
      <slot />
    </main>
    <Footer innstillinger={i} kategorier={k} />
  </body>
</html>
