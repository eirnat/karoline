# Kopier denne filen til .env og fyll inn. .env skal aldri committes.
# Etter endringer: lagre filen og start utviklingsserveren på nytt (Ctrl+C, så npm run dev).

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SITE_URL=https://fotografkarolinerage.com

# Valgfritt: site key fra Cloudflare Turnstile (offentlig). Uten den vises skjemaet uten spamsjekk.
PUBLIC_TURNSTILE_SITE_KEY=
